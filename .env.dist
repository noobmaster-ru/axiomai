POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_USER="axiomai"
POSTGRES_PASSWORD="axiomai"
POSTGRES_DB="axiomai_db"
POSTGRES_URL="postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

REDIS_PASSWORD="axiomai"
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/0"

# Production reverse proxy / frontend build
APP_DOMAIN="cashback.example.com"
ACME_EMAIL="ops@example.com"
# ТОЛЬКО для локальной разработки без Telegram: telegram_id вместо проверки initData. В проде НЕ задавать!
# API_AUTH_DEV_TELEGRAM_ID="111111111"
CORS_ALLOWED_ORIGINS="https://cashback.example.com"
VITE_ARTICLES_DATA_SOURCE="http"
VITE_API_BASE_URL="/api"

# Прокси для Telegram API (пусто — без прокси)
TELEGRAM_PROXY="http://64.188.56.207:8888"
BOT_TOKEN="bot-token"
# Владелец: получает копии сообщений селлеров и уведомления о низком балансе
OWNER_TELEGRAM_ID="111111111"
# Username поддержки, показывается пользователям в текстах бота
ADMIN_USERNAME="@support_username"
ADMIN_TELEGRAM_IDS="111111111,111111111"
JSON_LOGS=false

# Google Sheets
SERVICE_ACCOUNT_AXIOMAI="sunny-might-477012-c4-04c66c69a92f.json"
SERVICE_ACCOUNT_AXIOMAI_EMAIL="axiomai@gserviceaccount.com"

OPENAI_TOKEN="openai-token"
PROXY="http://proxy"

SUPERBANKING_API_KEY="api-key"
SUPERBANKING_CABINET_ID="cabinet-id"
SUPERBANKING_PROJECT_ID="project-id"
SUPERBANKING_CLEARING_CENTER_ID="clearing-center-id"

# Message Debouncer
# Задержка перед обработкой накопленных сообщений (секунды)
MESSAGE_DEBOUNCE_DELAY=10
# TTL для накопленных сообщений в Redis (секунды)
MESSAGE_ACCUMULATION_TTL=300
# Длина сообщения для немедленной обработки (символы)
IMMEDIATE_PROCESSING_LENGTH=500
